---
import Master from '../../../../layouts/Master.astro';

const modules = [
  { name: "Module 1 : Genèse, symptômes et idées reçues", slug: "genese-du-burnout" },
  { name: "Module 2 : Le piège des pensées : Stopper les ruminations", slug: "pensees-et-ruminations" },
  { name: "Module 3 : L'art du lâcher-prise et les sphères de vie", slug: "lacher-prise-et-spheres-de-vie" },
  { name: "Module 4 : Neurobiologie & Apaisement du système nerveux", slug: "neurobiologie-et-relaxation" },
  { name: "Module 5 : Préparer la reprise : Déconditionnement et limites durables", slug: "reprise-et-prevention" }
];

const dates = [
  "mercredi 16 septembre 2026 de 18h00 à 19h30",
  "mercredi 23 septembre 2026 de 18h00 à 19h30",
  "mercredi 30 septembre 2026 de 18h00 à 19h30",
  "mercredi 7 octobre 2026 de 18h00 à 19h30",
  "mercredi 14 octobre 2026 de 18h00 à 19h30"
];
---

<Master title="Inscription Cycle Burnout | StressAction" bodyClass="contact-page">

  <div class="page-title dark-background" data-aos="fade" style="background-image: url(/assets/img/contact-page-title-bg.jpg); background-color: #1a0b33; padding: 120px 0 60px 0; margin-top: 70px;">
    <div class="container">
      <h1>Inscription & Prise en charge</h1>
      <nav class="breadcrumbs">
        <ol class="list-unstyled d-flex text-white-50">
          <li><a href="/" class="text-white-50 text-decoration-none">Accueil</a></li>
          <li class="mx-2">/</li>
          <li><a href="/formations/burnout" class="text-white-50 text-decoration-none">Cycle Burnout</a></li>
          <li class="mx-2">/</li>
          <li class="current text-white">Inscription</li>
        </ol>
      </nav>
    </div>
  </div>

  <section id="inscription" class="contact section py-5">
    <div class="container position-relative" data-aos="fade-up" data-aos-delay="100">
      <div class="row gy-4">

        <!-- PANNEAU INFORMATIF GAUCHE -->
        <div class="col-lg-5">
          <div class="info-item d-flex flex-column shadow-sm" data-aos="fade-up" data-aos-delay="200" style="height: 100%; align-items: flex-start; text-align: left; padding: 30px; border-radius: 15px; background: #fdfcfa; border: 1px solid rgba(111, 66, 193, 0.1);">
            
            <div class="mb-4 w-100">
              <div class="d-flex align-items-center mb-3">
                <i class="bi bi-calendar-event fs-4 text-primary me-3"></i>
                <h4 class="mb-0 fw-bold">Dates des sessions</h4>
              </div>
              <div class="ms-5 text-muted small fw-bold">
                {dates.map((date) => (
                  <p class="mb-1">{date}</p>
                ))}
              </div>
            </div>

            <div class="mb-4 w-100">
              <div class="d-flex align-items-center mb-3">
                <i class="bi bi-geo-alt fs-4 text-primary me-3"></i>
                <h4 class="mb-0 fw-bold">Lieu de l'atelier</h4>
              </div>
              <p class="ms-5 text-muted small">
                <strong>Centre Thérapeutique Les Oranges</strong><br>
                <a target="_blank" rel="noopener noreferrer" href="https://maps.google.com/?q=Rue+Joseph+Wauters+191+7134+Peronnes-lez-Binche" class="text-decoration-none text-primary">
                  Rue Joseph Wauters n°191, 7134 Péronnes-lez-Binche
                </a>
              </p>
            </div>

            <hr class="w-100 opacity-10">

            <div class="mb-4 w-100">
              <div class="d-flex align-items-center mb-2">
                 <i class="bi bi-shield-check fs-3 text-primary me-3"></i>
                 <h4 class="mb-0 fw-bold">Prise en charge</h4>
              </div>
              <p class="ms-5 small text-muted mb-0">Formation éligible aux remboursements des soins psychologiques de première ligne (NISS requis).</p>
            </div>

            <div class="mb-4 w-100">
              <div class="d-flex align-items-center mb-2">
                 <i class="bi bi-currency-euro fs-3 text-primary me-3"></i>
                 <h4 class="mb-0 fw-bold">Tarif préférentiel</h4>
              </div>
              <p class="ms-5 small mb-0 text-dark fw-bold" style="font-size: 1.1rem;">
                2,50€ <span class="text-muted fw-normal" style="font-size: 0.9rem;">/ séance</span>
              </p>
              <p class="ms-5 small text-muted">Soit 12,50€ au total pour le cycle complet de 5 séances.</p>
            </div>

            <hr class="w-100 opacity-10">

            <h4 class="mt-2 fw-bold small text-uppercase" style="letter-spacing: 1px;">Programme des 5 modules :</h4>
            <ul class="list-unstyled mb-4 small">
              {modules.map((mod) => (
                <li class="d-flex align-items-start mb-2">
                  <i class="bi bi-check2-circle text-primary me-2"></i> 
                  <span class="text-dark">{mod.name}</span>
                </li>
              ))}
            </ul>

            <div class="mt-auto p-3 w-100" style="background: rgba(111, 66, 193, 0.05); border-radius: 8px; border-left: 4px solid #6f42c1;">
              <p class="mb-0 small text-muted">
                <i class="bi bi-info-circle me-2"></i> 
                <strong>Note :</strong> Après validation du formulaire, vous recevrez une confirmation et les modalités pratiques par email.
              </p>
            </div>
          </div>
        </div>

        <!-- FORMULAIRE D'INSCRIPTION DROITE -->
        <div class="col-lg-7">
          <div class="form-wrapper bg-white shadow-sm p-4 p-md-5 rounded-4 border">
            <div class="mb-4">
              <h3 class="fw-bold">Formulaire d'inscription</h3>
              <p class="text-muted small">Réservation pour le cycle Burnout — Démarrage le 16 septembre 2026.</p>
            </div>

            <form id="registrationForm">
              <input type="hidden" name="formation" value="burnout">
              <div class="row gy-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold small text-secondary">Nom et Prénom</label>
                  <input type="text" name="name" class="form-control custom-input" placeholder="Ex: Jean Dupont" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold small text-secondary">Email</label>
                  <input type="email" name="email" class="form-control custom-input" placeholder="Ex: jean@email.be" required>
                </div>

                <div class="col-md-12">
                  <label class="form-label fw-bold small text-secondary">Numéro NISS (Registre National)</label>
                  <input type="text" name="niss" class="form-control custom-input" placeholder="00.00.00-000.00" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold small text-secondary">Téléphone</label>
                  <input type="tel" name="phone" class="form-control custom-input" placeholder="Ex: 0470 00 00 00" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-bold small text-secondary">Vous êtes...</label>
                  <select name="status" class="form-select custom-input" required>
                    <option value="" disabled selected>Sélectionnez votre statut</option>
                    <option value="particulier">Un particulier</option>
                    <option value="independant">Un indépendant</option>
                    <option value="entreprise">Salarié / Entreprise</option>
                  </select>
                </div>

                <div class="col-md-12">
                  <label class="form-label fw-bold small text-secondary">Vos attentes principales (Optionnel)</label>
                  <textarea name="message" class="form-control custom-input" rows="3" placeholder="Avez-vous des questions ou des besoins particuliers pour cette session ?"></textarea>
                </div>

                <div class="col-md-12 text-center mt-4">
                  <div id="form-loader" class="alert alert-info py-2" style="display:none;">
                    <span class="spinner-border spinner-border-sm me-2"></span> Enregistrement de votre inscription en cours...
                  </div>
                  <div id="form-success" class="alert alert-success py-3" style="display:none;">
                    <h5 class="fw-bold mb-1">Inscription bien reçue !</h5>
                    <p class="mb-0 small">Merci. Votre demande a bien été transmise pour la session de Péronnes-lez-Binche.</p>
                  </div>
                  
                  <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm">
                    Confirmer mon inscription
                  </button>
                  
                  <p class="mt-3 mb-0 text-muted" style="font-size: 11px;">
                    <i class="bi bi-lock-fill me-1 text-success"></i> Données protégées et traitées sous secret professionnel selon le RGPD.
                  </p>
                </div>
              </div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <script>
    // Utilisation de la variable dédiée au burnout (ou fallback si tu partages le même script Google)
    const SCRIPT_URL = import.meta.env.PUBLIC_BURNOUT_FORMATION_URL || import.meta.env.PUBLIC_STRESS_FORMATION_URL;

    const regForm = document.getElementById('registrationForm');

    regForm.addEventListener('submit', e => {
      e.preventDefault();
      
      const btn = document.getElementById('submitBtn');
      const loader = document.getElementById('form-loader');
      const successMsg = document.getElementById('form-success');

      btn.disabled = true;
      btn.style.display = 'none';
      loader.style.display = 'block';

      fetch(SCRIPT_URL, { method: 'POST', body: new FormData(regForm)})
        .then(response => {
          loader.style.display = 'none';
          successMsg.style.display = 'block';
          regForm.reset();
        })
        .catch(error => {
          console.error('Erreur lors de la soumission :', error.message);
          loader.style.display = 'none';
          btn.style.display = 'block';
          btn.disabled = false;
          alert("Une erreur est survenue lors de l'envoi. Veuillez réessayer ou nous contacter directement.");
        });
    });
  </script>

</Master>

<style>
  :global(#header) { 
    background: #1a0b33 !important; 
    z-index: 1030 !important;
  }

  .custom-input {
    padding: 10px 15px;
    border-radius: 8px;
    border: 1px solid #dee2e6;
    font-size: 14px;
  }
  .custom-input:focus {
    border-color: #6f42c1;
    box-shadow: 0 0 0 0.25rem rgba(111, 66, 193, 0.1);
  }

  .btn-primary {
    background-color: #6f42c1;
    border-color: #6f42c1;
  }
  .btn-primary:hover {
    background-color: #59339d;
    border-color: #59339d;
  }
</style>